# ---- app ----
APP_ENV=dev                      # dev | staging | prod
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173

# ---- database ----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=appdb
DATABASE_URL=postgresql+asyncpg://app:change-me@db:5432/appdb
# MONGODB_URI=mongodb://mongo:27017/appdb
# --- Supabase (managed Postgres + pgvector), if chosen ---
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=            # server-side only, never in a frontend build
# SUPABASE_DB_URL=postgresql+asyncpg://...   # direct connection for SQLAlchemy/Alembic

# ---- redis (cache, rate limit, jobs) ----
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LLM=10/minute

# ---- auth ----
JWT_SECRET=                      # >= 32 bytes, or use the IdP's JWKS
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ---- ai ----
CHATBOT_ENABLED=false
MAIN_MODEL=                        # e.g. openai:gpt-... or openai:<vllm served-model-name>
FAST_MODEL=
FALLBACK_MODEL=
# OpenAI-compatible endpoints (vLLM / LiteLLM / Azure OpenAI). Empty = provider default.
LLM_BASE_URL=                      # e.g. http://vllm-llm:8000/v1
LLM_API_KEY=
EMBEDDING_BASE_URL=                # e.g. http://vllm-embed:8000/v1
EMBEDDING_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
QDRANT_URL=http://qdrant:6333
# Using pgvector instead of Qdrant? Drop QDRANT_URL and set:
# VECTOR_BACKEND=pgvector          # qdrant | pgvector | azure_search
# VECTOR_TABLE=document_chunks
EMBEDDING_DIM=1024
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=rerank-multilingual-v3.0
MAX_TOKENS=1024
USER_DAILY_TOKEN_QUOTA=100000

# ---- observability ----
LANGSMITH_API_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
OTEL_ENABLED=false
METRICS_ENABLED=true               # exposes /metrics for Prometheus
GRAFANA_PASSWORD=admin             # dev only: Grafana listens on 127.0.0.1 and isn't published in prod. Set a long random value before putting it behind a proxy.
SENTRY_DSN=
